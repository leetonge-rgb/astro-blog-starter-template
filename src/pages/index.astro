---
// Replace these with your actual links and details
const name = "Lee Tonge";
const title = "CV Writer & Career Consultant";
const bio = "20+ years helping UK professionals write CVs that get interviews.";
const established = "Est. 2001 · York, UK";
const profileImageUrl = "https://raw.githubusercontent.com/leetonge-rgb/astro-blog-starter-template/refs/heads/main/public/profile.jpeg";
const websiteUrl = "https://www.thecvstore.net";
const linkedinUrl = "https://www.linkedin.com/in/leetonge/";
const whatsappNumber = "447359036005"; // Include country code, no + or spaces
const freeReviewUrl = "https://www.thecvstore.net/Free-CV-Review.php";
---
<html lang="en">
  <head>
    <meta charset="utf-8" />
    <meta name="viewport" content="width=device-width, initial-scale=1" />
    <meta name="description" content={bio} />
    <meta property="og:title" content={name} />
    <meta property="og:description" content={bio} />
    <meta property="og:image" content={profileImageUrl} />
    <title>{name} · {title}</title>
    <link rel="preconnect" href="https://fonts.googleapis.com" />
    <link rel="preconnect" href="https://fonts.gstatic.com" crossorigin />
    <link href="https://fonts.googleapis.com/css2?family=Fraunces:ital,opsz,wght@0,9..144,500;0,9..144,600;0,9..144,700;1,9..144,500&family=Inter:wght@400;500;600;700&display=swap" rel="stylesheet" />
  </head>
  <body>
    <main class="sheet">
      <div class="eyebrow">{established}</div>

      <div class="portrait">
        <img src={profileImageUrl} alt={name} class="avatar" />
        <span class="ring" aria-hidden="true"></span>
      </div>

      <h1 class="name">
        {name}
        <svg class="mark" viewBox="0 0 220 18" preserveAspectRatio="none" aria-hidden="true">
          <path d="M4 11 C 50 2, 100 2, 108 9 C 116 16, 165 2, 216 8" />
        </svg>
      </h1>
      <p class="role">{title}</p>
      <p class="bio">{bio}</p>

      <a href={freeReviewUrl} target="_blank" rel="noopener" class="cta">
        <span class="cta-text">
          <span class="cta-kicker">No obligation</span>
          Get your free CV review
        </span>
        <span class="stamp" aria-hidden="true">
          <svg viewBox="0 0 100 100">
            <defs>
              <path id="stampCircle" d="M 50,50 m -38,0 a 38,38 0 1,1 76,0 a 38,38 0 1,1 -76,0" />
            </defs>
            <circle cx="50" cy="50" r="46" class="stamp-ring" />
            <circle cx="50" cy="50" r="30" class="stamp-ring-inner" />
            <text font-size="8.6" letter-spacing="1.5" fill="currentColor">
              <textPath href="#stampCircle" startOffset="1%">FREE CV REVIEW · NO OBLIGATION ·</textPath>
            </text>
          </svg>
          <span class="stamp-arrow">&rarr;</span>
        </span>
      </a>

      <div class="pillars">
        <div class="pillar">
          <svg viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="1.6"><path d="M7 3h8l4 4v14H7z"/><path d="M15 3v4h4"/><path d="M9.5 12h5M9.5 15.5h5"/></svg>
          <span>CV Writing</span>
        </div>
        <div class="pillar">
          <svg viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="1.6"><circle cx="12" cy="12" r="9"/><path d="m14.5 9.5-2 5-5 2 2-5 5-2Z"/></svg>
          <span>Career Consultancy</span>
        </div>
        <div class="pillar">
          <svg viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="1.6"><path d="M12 3 4 6.5v5C4 16.5 7.4 20 12 21c4.6-1 8-4.5 8-9.5v-5L12 3Z"/><path d="m9 12 2 2 4-4"/></svg>
          <span>Free CV Review</span>
        </div>
      </div>

      <hr class="rule" />

      <nav class="links">
        <a href={websiteUrl} target="_blank" rel="noopener" class="btn">
          <span class="btn-icon" data-accent="brass" aria-hidden="true">
            <svg viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="1.6"><circle cx="12" cy="12" r="9"/><path d="M3 12h18M12 3c2.8 2.6 4.2 5.7 4.2 9s-1.4 6.4-4.2 9c-2.8-2.6-4.2-5.7-4.2-9S9.2 5.6 12 3Z"/></svg>
          </span>
          <span class="btn-text">Visit the website</span>
          <span class="btn-arrow" aria-hidden="true">&rarr;</span>
        </a>

        <a href={linkedinUrl} target="_blank" rel="noopener" class="btn">
          <span class="btn-icon" data-accent="linkedin" aria-hidden="true">
            <svg viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="1.6"><rect x="3" y="3" width="18" height="18" rx="2"/><path d="M7.5 10.5v6M7.5 7.5v.01M11.5 16.5v-3.7c0-1.4 1-2.3 2.3-2.3s2.2.9 2.2 2.3v3.7"/></svg>
          </span>
          <span class="btn-text">Connect on LinkedIn</span>
          <span class="btn-arrow" aria-hidden="true">&rarr;</span>
        </a>

        <a href={`https://wa.me/${whatsappNumber}`} target="_blank" rel="noopener" class="btn">
          <span class="btn-icon" data-accent="whatsapp" aria-hidden="true">
            <svg viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="1.6"><path d="M4 20l1.3-4A8 8 0 1 1 8.5 19L4 20Z"/><path d="M8.8 9.6c.2 2.6 2.5 4.9 5.1 5.1"/></svg>
          </span>
          <span class="btn-text">Chat on WhatsApp</span>
          <span class="btn-arrow" aria-hidden="true">&rarr;</span>
        </a>
      </nav>

      <p class="footer">Precision CVs, since 2001.</p>
    </main>

    <style>
      :root {
        --ink: #0b1526;
        --ink-soft: #16233a;
        --paper: #eef1f5;
        --paper-dim: #c9cfda;
        --text: #14213d;
        --text-muted: #55617a;
        --brass: #b8863b;
        --brass-light: #e4c988;
        --redline: #8a2f2f;
        --linkedin: #0a66c2;
        --whatsapp: #1fa855;
      }

      * { box-sizing: border-box; }
      html, body { margin: 0; padding: 0; }

      body {
        min-height: 100vh;
        display: flex;
        justify-content: center;
        align-items: center;
        padding: 32px 18px;
        font-family: 'Inter', system-ui, -apple-system, sans-serif;
        color: var(--text);
        background:
          radial-gradient(120% 90% at 50% -10%, #1a2b4a 0%, var(--ink) 55%),
          repeating-linear-gradient(to bottom, transparent 0, transparent 27px, rgba(255,255,255,0.025) 28px);
        background-color: var(--ink);
      }

      .sheet {
        position: relative;
        width: 100%;
        max-width: 420px;
        background: var(--paper);
        padding: 44px 34px 34px;
        text-align: center;
        box-shadow: 0 30px 60px -20px rgba(0,0,0,0.55), 0 2px 0 rgba(255,255,255,0.4) inset;
        border-top: 3px solid var(--brass);
        animation: rise 0.7s cubic-bezier(.2,.7,.2,1) both;
      }

      .eyebrow {
        font-size: 0.68rem;
        letter-spacing: 0.16em;
        text-transform: uppercase;
        color: var(--brass);
        font-weight: 600;
        margin-bottom: 22px;
      }

      .portrait { position: relative; width: 104px; height: 104px; margin: 0 auto 22px; }
      .avatar {
        width: 100%; height: 100%; border-radius: 50%; object-fit: cover;
        display: block; position: relative; z-index: 1; border: 3px solid var(--paper);
      }
      .ring { position: absolute; inset: -6px; border-radius: 50%; border: 1px solid var(--brass); opacity: 0.55; }

      .name {
        position: relative;
        display: inline-block;
        font-family: 'Fraunces', Georgia, serif;
        font-weight: 600;
        font-size: 1.9rem;
        letter-spacing: -0.01em;
        margin: 0 0 6px;
        color: var(--text);
      }

      .mark { position: absolute; left: -6%; bottom: -10px; width: 112%; height: 14px; overflow: visible; }
      .mark path {
        fill: none; stroke: var(--redline); stroke-width: 2.4; stroke-linecap: round;
        stroke-dasharray: 260; stroke-dashoffset: 260;
        animation: draw 0.9s 0.5s cubic-bezier(.2,.7,.2,1) forwards;
      }

      .role { margin: 14px 0 4px; font-size: 0.82rem; font-weight: 600; letter-spacing: 0.04em; color: var(--text-muted); }
      .bio { margin: 0 0 26px; font-size: 0.92rem; line-height: 1.55; color: var(--text-muted); }

      /* Primary CTA */
      .cta {
        position: relative;
        display: flex;
        align-items: center;
        justify-content: space-between;
        gap: 12px;
        background: var(--ink);
        color: var(--paper);
        text-decoration: none;
        padding: 18px 66px 18px 22px;
        margin-bottom: 30px;
        border: 1px solid var(--ink);
        transition: transform 0.2s ease, box-shadow 0.2s ease;
      }
      .cta:hover, .cta:focus-visible {
        transform: translateY(-2px);
        box-shadow: 0 14px 24px -10px rgba(0,0,0,0.45);
      }
      .cta:focus-visible { outline: 2px solid var(--brass); outline-offset: 3px; }

      .cta-text { text-align: left; font-weight: 700; font-size: 1.02rem; line-height: 1.3; }
      .cta-kicker {
        display: block;
        font-family: 'Inter', sans-serif;
        font-weight: 600;
        font-size: 0.62rem;
        letter-spacing: 0.14em;
        text-transform: uppercase;
        color: var(--brass-light);
        margin-bottom: 3px;
      }

      .stamp {
        position: absolute;
        right: 8px;
        top: 50%;
        transform: translateY(-50%);
        width: 54px;
        height: 54px;
        color: var(--brass-light);
      }
      .stamp svg {
        width: 100%;
        height: 100%;
        animation: spin 14s linear infinite;
      }
      .stamp-ring, .stamp-ring-inner {
        fill: none;
        stroke: currentColor;
        stroke-width: 1;
        opacity: 0.7;
      }
      .stamp-arrow {
        position: absolute;
        inset: 0;
        display: flex;
        align-items: center;
        justify-content: center;
        font-size: 1.15rem;
        color: var(--paper);
      }

      .pillars {
        display: flex;
        justify-content: space-between;
        gap: 10px;
        margin-bottom: 30px;
      }
      .pillar {
        flex: 1;
        display: flex;
        flex-direction: column;
        align-items: center;
        gap: 8px;
        font-size: 0.68rem;
        font-weight: 600;
        color: var(--text-muted);
        letter-spacing: 0.01em;
      }
      .pillar svg { width: 22px; height: 22px; color: var(--brass); }

      .rule { border: none; border-top: 1px solid var(--paper-dim); margin: 0 0 26px; }

      .links { display: flex; flex-direction: column; gap: 10px; }

      .btn {
        position: relative;
        display: flex;
        align-items: center;
        gap: 12px;
        padding: 13px 16px;
        border: 1px solid var(--text);
        color: var(--text);
        text-decoration: none;
        font-weight: 600;
        font-size: 0.9rem;
        overflow: hidden;
        transition: color 0.25s ease, border-color 0.25s ease;
      }
      .btn::before {
        content: "";
        position: absolute;
        inset: 0;
        background: var(--ink);
        transform: translateX(-101%);
        transition: transform 0.3s cubic-bezier(.2,.7,.2,1);
        z-index: 0;
      }
      .btn:hover, .btn:focus-visible { color: var(--paper); border-color: var(--ink); }
      .btn:hover::before, .btn:focus-visible::before { transform: translateX(0); }
      .btn:focus-visible { outline: 2px solid var(--brass); outline-offset: 3px; }

      .btn-icon, .btn-text, .btn-arrow { position: relative; z-index: 1; }
      .btn-icon { width: 20px; height: 20px; flex-shrink: 0; display: flex; }
      .btn-icon svg { width: 100%; height: 100%; }
      .btn-icon[data-accent="brass"] { color: var(--brass); }
      .btn-icon[data-accent="linkedin"] { color: var(--linkedin); }
      .btn-icon[data-accent="whatsapp"] { color: var(--whatsapp); }
      .btn:hover .btn-icon, .btn:focus-visible .btn-icon { color: inherit; }

      .btn-text { flex: 1; text-align: left; }
      .btn-arrow { transition: transform 0.25s ease; }
      .btn:hover .btn-arrow, .btn:focus-visible .btn-arrow { transform: translateX(3px); }

      .footer {
        margin: 28px 0 0;
        font-family: 'Fraunces', Georgia, serif;
        font-style: italic;
        font-size: 0.8rem;
        color: var(--text-muted);
      }

      @keyframes rise { from { opacity: 0; transform: translateY(14px); } to { opacity: 1; transform: translateY(0); } }
      @keyframes draw { to { stroke-dashoffset: 0; } }
      @keyframes spin { to { transform: rotate(360deg); } }

      @media (prefers-reduced-motion: reduce) {
        .sheet { animation: none; }
        .mark path { animation: none; stroke-dashoffset: 0; }
        .stamp svg { animation: none; }
      }

      @media (max-width: 420px) {
        .sheet { padding: 36px 22px 28px; }
        .name { font-size: 1.6rem; }
        .cta { padding: 16px 60px 16px 18px; }
        .pillars { gap: 6px; }
        .pillar { font-size: 0.6rem; }
      }
    </style>
  </body>
</html>
