---
// Replace these with your actual links and details
const name = "Lee Tonge";
const bio = "Welcome to my personal link hub.";
const profileImageUrl = "https://raw.githubusercontent.com/leetonge-rgb/astro-blog-starter-template/refs/heads/main/public/profile.jpeg"; // Put your photo in public/profile.jpeg

const websiteUrl = "https://www.thecvstore.net"; 
const linkedinUrl = "https://www.linkedin.com/in/leetonge/";
const whatsappNumber = "447359036005"; // Include country code, no + or spaces
---

<html lang="en">
  <head>
    <meta charset="utf-8" />
    <meta name="viewport" content="width=device-width, initial-scale=1" />
    <title>{name}</title>
  </head>
  <body>
    <main class="card">
      <img src={profileImageUrl} alt={name} class="avatar" />
      <h1>{name}</h1>
      <p>{bio}</p>

      <div class="links">
        <a href={websiteUrl} target="_blank" rel="noopener" class="btn">
          🌐 Visit My Website
        </a>

        <a href={linkedinUrl} target="_blank" rel="noopener" class="btn linkedin">
          💼 Connect on LinkedIn
        </a>

        <a href={`https://wa.me/${whatsappNumber}`} target="_blank" rel="noopener" class="btn whatsapp">
          💬 Chat on WhatsApp
        </a>
      </div>
    </main>

    <style>
      :root {
        --bg-color: #f4f4f7;
        --card-bg: #ffffff;
        --text-color: #1a1a1a;
        --btn-bg: #2d3748;
        --btn-text: #ffffff;
      }

      body {
        margin: 0;
        padding: 20px;
        font-family: system-ui, -apple-system, BlinkMacSystemFont, 'Segoe UI', Roboto, sans-serif;
        background-color: var(--bg-color);
        display: flex;
        justify-content: center;
        align-items: center;
        min-height: 100vh;
      }

      .card {
        background: var(--card-bg);
        padding: 40px 30px;
        border-radius: 20px;
        box-shadow: 0 10px 30px rgba(0,0,0,0.08);
        text-align: center;
        max-width: 380px;
        width: 100%;
      }

      .avatar {
        width: 120px;
        height: 120px;
        border-radius: 50%;
        object-fit: cover;
        margin-bottom: 15px;
        border: 4px solid var(--bg-color);
      }

      h1 {
        margin: 0 0 5px 0;
        font-size: 1.6rem;
        color: var(--text-color);
      }

      p {
        margin: 0 0 25px 0;
        color: #666;
        font-size: 0.95rem;
      }

      .links {
        display: flex;
        flex-direction: column;
        gap: 12px;
      }

      .btn {
        display: block;
        padding: 14px 20px;
        background: var(--btn-bg);
        color: var(--btn-text);
        text-decoration: none;
        border-radius: 10px;
        font-weight: 600;
        font-size: 0.95rem;
        transition: transform 0.15s ease, opacity 0.15s ease;
      }

      .btn:hover {
        transform: translateY(-2px);
        opacity: 0.95;
      }

      .btn.linkedin {
        background: #0a66c2;
      }

      .btn.whatsapp {
        background: #25d366;
      }
    </style>
  </body>
</html>
