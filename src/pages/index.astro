---
// Replace these with your actual links and details
const name = "Lee Tonge";
const title = "Founder & Director of The CV Store";
const headline = "A personal, one-to-one approach to CV writing.";
const bio = "20+ years helping professionals globally - from graduates to CEOs - writing CVs that secure interviews.";
const established = "Established in 2001";
const profileImageUrl = "https://raw.githubusercontent.com/leetonge-rgb/astro-blog-starter-template/refs/heads/main/public/profile.jpeg";
const websiteUrl = "https://www.thecvstore.net";
const linkedinUrl = "https://www.linkedin.com/in/leetonge/";
const whatsappNumber = "447359036005"; // Include country code, no + or spaces
const freeReviewUrl = "https://www.thecvstore.net/Free-CV-Review.php";

const stats = [
  { value: "21+", label: "Years' experience" },
  { value: "2001", label: "Est. in London" },
  { value: "5.0", label: "Trustpilot · 785+ reviews" },
  { value: "0%", label: "AI - bespoke, every time" },
];

const services = [
  { name: "CV Writing", desc: "Bespoke, ATS-friendly CVs built from scratch - no templates." },
  { name: "Cover Letters", desc: "Tailored to the specific role, not a generic 'copy-and-paste'." },
  { name: "Career Consultancy", desc: "Guidance for managers through to C-suite, at every stage." },
  { name: "Free CV Review", desc: "A no-obligation second opinion before you commit to anything." },
];
---
<html lang="en">
  <head>
    <meta charset="utf-8" />
    <meta name="viewport" content="width=device-width, initial-scale=1" />
    <meta name="description" content={bio} />
    <meta property="og:title" content={name} />
    <meta property="og:description" content={bio} />
    <meta property="og:image" content={profileImageUrl} />
    <title>{name} · {title}</title>
    <link rel="preconnect" href="https://fonts.googleapis.com" />
    <link rel="preconnect" href="https://fonts.gstatic.com" crossorigin />
    <link href="https://fonts.googleapis.com/css2?family=Fraunces:ital,opsz,wght@0,9..144,500;0,9..144,600;0,9..144,700;1,9..144,500&family=Inter:wght@400;500;600;700&display=swap" rel="stylesheet" />
  </head>
  <body>

    <!-- HERO -->
    <section class="hero">
      <div class="hero-inner">
        <div class="hero-copy">
          <div class="eyebrow">{established}</div>
          <h1 class="name">
            {name}
            <svg class="mark" viewBox="0 0 220 18" preserveAspectRatio="none" aria-hidden="true">
              <path d="M4 11 C 50 2, 100 2, 108 9 C 116 16, 165 2, 216 8" />
            </svg>
          </h1>
          <p class="role">{title}</p>
          <p class="headline">{headline}</p>
          <p class="bio">{bio}</p>

          <div class="hero-actions">
            <a href={freeReviewUrl} target="_blank" rel="noopener" class="cta">
              <span class="cta-text">
                <span class="cta-kicker">No obligation</span>
                Get your free CV review
              </span>
              <span class="stamp" aria-hidden="true">
                <svg viewBox="0 0 100 100">
                  <defs>
                    <path id="stampCircle" d="M 50,50 m -38,0 a 38,38 0 1,1 76,0 a 38,38 0 1,1 -76,0" />
                  </defs>
                  <circle cx="50" cy="50" r="46" class="stamp-ring" />
                  <circle cx="50" cy="50" r="30" class="stamp-ring-inner" />
                  <text font-size="8.6" letter-spacing="1.5" fill="currentColor">
                    <textPath href="#stampCircle" startOffset="1%">FREE CV REVIEW · NO OBLIGATION ·</textPath>
                  </text>
                </svg>
                <span class="stamp-arrow">&rarr;</span>
              </span>
            </a>
            <a href={websiteUrl} target="_blank" rel="noopener" class="ghost">Visit the website &rarr;</a>
          </div>
        </div>

        <div class="hero-portrait">
          <div class="portrait">
            <img src={profileImageUrl} alt={name} class="avatar" />
            <span class="ring" aria-hidden="true"></span>
          </div>
        </div>
      </div>
    </section>

    <!-- STATS STRIP -->
    <section class="stats">
      <div class="stats-inner">
        {stats.map((s) => (
          <div class="stat">
            <span class="stat-value">{s.value}</span>
            <span class="stat-label">{s.label}</span>
          </div>
        ))}
      </div>
    </section>

    <!-- TESTIMONIAL -->
    <section class="testimonial">
      <div class="testimonial-inner">
        <p class="quote">
          One client, let down by a previous, generic CV service, said Lee turned a bland document into one that actually reflected their experience and results.
        </p>
        <p class="attribution">- Verified client, Trustpilot</p>
      </div>
    </section>

    <!-- SERVICES -->
    <section class="services">
      <div class="services-inner">
        <h2 class="section-title">What I help with</h2>
        <div class="service-grid">
          {services.map((s) => (
            <div class="service">
              <span class="service-mark" aria-hidden="true"></span>
              <h3>{s.name}</h3>
              <p>{s.desc}</p>
            </div>
          ))}
        </div>
      </div>
    </section>

    <!-- LINKS / FOOTER -->
    <section class="contact">
      <div class="contact-inner">
        <h2 class="section-title light">Get in touch</h2>
        <nav class="links">
          <a href={websiteUrl} target="_blank" rel="noopener" class="btn">
            <span class="btn-icon" data-accent="brass" aria-hidden="true">
              <svg viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="1.6"><circle cx="12" cy="12" r="9"/><path d="M3 12h18M12 3c2.8 2.6 4.2 5.7 4.2 9s-1.4 6.4-4.2 9c-2.8-2.6-4.2-5.7-4.2-9S9.2 5.6 12 3Z"/></svg>
            </span>
            <span class="btn-text">Visit the website</span>
            <span class="btn-arrow" aria-hidden="true">&rarr;</span>
          </a>

          <a href={linkedinUrl} target="_blank" rel="noopener" class="btn">
            <span class="btn-icon" data-accent="linkedin" aria-hidden="true">
              <svg viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="1.6"><rect x="3" y="3" width="18" height="18" rx="2"/><path d="M7.5 10.5v6M7.5 7.5v.01M11.5 16.5v-3.7c0-1.4 1-2.3 2.3-2.3s2.2.9 2.2 2.3v3.7"/></svg>
            </span>
            <span class="btn-text">Connect on LinkedIn</span>
            <span class="btn-arrow" aria-hidden="true">&rarr;</span>
          </a>

          <a href={`https://wa.me/${whatsappNumber}`} target="_blank" rel="noopener" class="btn">
            <span class="btn-icon" data-accent="whatsapp" aria-hidden="true">
              <svg viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="1.6"><path d="M4 20l1.3-4A8 8 0 1 1 8.5 19L4 20Z"/><path d="M8.8 9.6c.2 2.6 2.5 4.9 5.1 5.1"/></svg>
            </span>
            <span class="btn-text">Chat on WhatsApp</span>
            <span class="btn-arrow" aria-hidden="true">&rarr;</span>
          </a>
        </nav>
        <p class="footer">I write the things you’re too modest (or busy) to say.</p>
      </div>
    </section>

    <style>
      :root {
        --ink: #0b1526;
        --ink-soft: #16233a;
        --paper: #eef1f5;
        --paper-dim: #c9cfda;
        --text: #14213d;
        --text-muted: #55617a;
        --brass: #b8863b;
        --brass-light: #e4c988;
        --redline: #8a2f2f;
        --linkedin: #0a66c2;
        --whatsapp: #1fa855;
      }

      * { box-sizing: border-box; }
      html, body { margin: 0; padding: 0; }
      body {
        font-family: 'Inter', system-ui, -apple-system, sans-serif;
        color: var(--text);
        background: var(--paper);
      }

      .eyebrow {
        font-size: 0.7rem;
        letter-spacing: 0.16em;
        text-transform: uppercase;
        color: var(--brass-light);
        font-weight: 600;
        margin-bottom: 18px;
      }

      /* HERO */
      .hero {
        background:
          radial-gradient(120% 90% at 20% -10%, #1a2b4a 0%, var(--ink) 55%),
          repeating-linear-gradient(to bottom, transparent 0, transparent 27px, rgba(255,255,255,0.025) 28px);
        background-color: var(--ink);
        color: var(--paper);
        padding: 90px 24px 70px;
      }
      .hero-inner {
        max-width: 1080px;
        margin: 0 auto;
        display: flex;
        align-items: center;
        gap: 64px;
        animation: rise 0.7s cubic-bezier(.2,.7,.2,1) both;
      }
      .hero-copy { flex: 1.3; }

      .name {
        position: relative;
        display: inline-block;
        font-family: 'Fraunces', Georgia, serif;
        font-weight: 700;
        font-size: clamp(2.4rem, 5vw, 3.6rem);
        letter-spacing: -0.01em;
        margin: 0 0 8px;
        color: var(--paper);
        line-height: 1.05;
      }
      .mark { position: absolute; left: -2%; bottom: -12px; width: 108%; height: 16px; overflow: visible; }
      .mark path {
        fill: none; stroke: var(--redline); stroke-width: 2.6; stroke-linecap: round;
        stroke-dasharray: 260; stroke-dashoffset: 260;
        animation: draw 0.9s 0.5s cubic-bezier(.2,.7,.2,1) forwards;
      }

      .role { margin: 18px 0 4px; font-size: 0.9rem; font-weight: 600; letter-spacing: 0.03em; color: var(--brass-light); }
      .headline {
        font-family: 'Fraunces', Georgia, serif;
        font-style: italic;
        font-weight: 500;
        font-size: 1.3rem;
        margin: 10px 0 14px;
        color: var(--paper);
        max-width: 30ch;
      }
      .bio { margin: 0 0 34px; font-size: 1rem; line-height: 1.65; color: #b7c0d1; max-width: 42ch; }

      .hero-actions { display: flex; flex-wrap: wrap; gap: 14px; align-items: center; }

      .hero-portrait { flex: 0 0 auto; display: flex; justify-content: center; }
      .portrait { position: relative; width: 220px; height: 220px; }
      .avatar {
        width: 100%; height: 100%; border-radius: 50%; object-fit: cover;
        display: block; position: relative; z-index: 1; border: 4px solid var(--ink);
      }
      .ring { position: absolute; inset: -10px; border-radius: 50%; border: 1px solid var(--brass); opacity: 0.55; }

      /* CTA button */
      .cta {
        position: relative;
        display: flex;
        align-items: center;
        justify-content: space-between;
        gap: 12px;
        background: var(--brass);
        color: var(--ink);
        text-decoration: none;
        padding: 18px 68px 18px 22px;
        border: 1px solid var(--brass);
        transition: transform 0.2s ease, box-shadow 0.2s ease;
      }
      .cta:hover, .cta:focus-visible {
        transform: translateY(-2px);
        box-shadow: 0 14px 24px -10px rgba(0,0,0,0.5);
      }
      .cta:focus-visible { outline: 2px solid var(--paper); outline-offset: 3px; }
      .cta-text { text-align: left; font-weight: 700; font-size: 1.02rem; line-height: 1.3; }
      .cta-kicker {
        display: block; font-weight: 700; font-size: 0.62rem; letter-spacing: 0.14em;
        text-transform: uppercase; color: var(--ink-soft); margin-bottom: 3px; opacity: 0.75;
      }
      .stamp {
        position: absolute; right: 8px; top: 50%; transform: translateY(-50%);
        width: 52px; height: 52px; color: var(--ink);
      }
      .stamp svg { width: 100%; height: 100%; animation: spin 14s linear infinite; }
      .stamp-ring, .stamp-ring-inner { fill: none; stroke: currentColor; stroke-width: 1; opacity: 0.55; }
      .stamp-arrow {
        position: absolute; inset: 0; display: flex; align-items: center; justify-content: center;
        font-size: 1.1rem; color: var(--ink);
      }

      .ghost {
        color: var(--paper);
        border: 1px solid rgba(238,241,245,0.4);
        text-decoration: none;
        font-weight: 600;
        font-size: 0.92rem;
        padding: 17px 20px;
        transition: border-color 0.2s ease, background 0.2s ease;
      }
      .ghost:hover, .ghost:focus-visible { border-color: var(--paper); background: rgba(238,241,245,0.06); }

      /* STATS */
      .stats { border-bottom: 1px solid var(--paper-dim); }
      .stats-inner {
        max-width: 1080px; margin: 0 auto;
        display: grid; grid-template-columns: repeat(4, 1fr);
      }
      .stat {
        padding: 30px 20px;
        text-align: center;
        border-left: 1px solid var(--paper-dim);
      }
      .stat:first-child { border-left: none; }
      .stat-value {
        display: block; font-family: 'Fraunces', Georgia, serif; font-weight: 600;
        font-size: 2rem; color: var(--brass); line-height: 1;
      }
      .stat-label { display: block; margin-top: 8px; font-size: 0.72rem; color: var(--text-muted); font-weight: 600; letter-spacing: 0.02em; }

      /* TESTIMONIAL */
      .testimonial { padding: 70px 24px; border-bottom: 1px solid var(--paper-dim); }
      .testimonial-inner { max-width: 640px; margin: 0 auto; text-align: center; }
      .quote {
        font-family: 'Fraunces', Georgia, serif;
        font-style: italic;
        font-weight: 500;
        font-size: 1.35rem;
        line-height: 1.5;
        color: var(--text);
        margin: 0 0 18px;
      }
      .attribution { font-size: 0.78rem; letter-spacing: 0.04em; text-transform: uppercase; font-weight: 600; color: var(--text-muted); }

      /* SERVICES */
      .services { padding: 70px 24px; border-bottom: 1px solid var(--paper-dim); }
      .services-inner { max-width: 1080px; margin: 0 auto; }
      .section-title {
        font-family: 'Fraunces', Georgia, serif; font-weight: 600; font-size: 1.6rem;
        margin: 0 0 40px; text-align: center; color: var(--text);
      }
      .section-title.light { color: var(--paper); }
      .service-grid { display: grid; grid-template-columns: repeat(4, 1fr); gap: 28px; }
      .service { border-top: 3px solid var(--brass); padding-top: 16px; }
      .service h3 { font-size: 1rem; margin: 0 0 8px; }
      .service p { font-size: 0.86rem; color: var(--text-muted); line-height: 1.55; margin: 0; }

      /* CONTACT / FOOTER */
      .contact { background: var(--ink); color: var(--paper); padding: 70px 24px 50px; }
      .contact-inner { max-width: 480px; margin: 0 auto; }

      .links { display: flex; flex-direction: column; gap: 10px; margin-bottom: 34px; }
      .btn {
        position: relative; display: flex; align-items: center; gap: 12px;
        padding: 14px 18px; border: 1px solid rgba(238,241,245,0.35); color: var(--paper);
        text-decoration: none; font-weight: 600; font-size: 0.92rem; overflow: hidden;
        transition: color 0.25s ease, border-color 0.25s ease;
      }
      .btn::before {
        content: ""; position: absolute; inset: 0; background: var(--brass);
        transform: translateX(-101%); transition: transform 0.3s cubic-bezier(.2,.7,.2,1); z-index: 0;
      }
      .btn:hover, .btn:focus-visible { color: var(--ink); border-color: var(--brass); }
      .btn:hover::before, .btn:focus-visible::before { transform: translateX(0); }
      .btn:focus-visible { outline: 2px solid var(--brass-light); outline-offset: 3px; }
      .btn-icon, .btn-text, .btn-arrow { position: relative; z-index: 1; }
      .btn-icon { width: 20px; height: 20px; flex-shrink: 0; display: flex; }
      .btn-icon svg { width: 100%; height: 100%; }
      .btn-icon[data-accent="brass"] { color: var(--brass-light); }
      .btn-icon[data-accent="linkedin"] { color: #5b9fe0; }
      .btn-icon[data-accent="whatsapp"] { color: #4fd68c; }
      .btn:hover .btn-icon, .btn:focus-visible .btn-icon { color: inherit; }
      .btn-text { flex: 1; text-align: left; }
      .btn-arrow { transition: transform 0.25s ease; }
      .btn:hover .btn-arrow, .btn:focus-visible .btn-arrow { transform: translateX(3px); }

      .footer {
        text-align: center;
        font-family: 'Fraunces', Georgia, serif;
        font-style: italic;
        font-size: 0.85rem;
        color: #8b96ab;
        margin: 0;
      }

      @keyframes rise { from { opacity: 0; transform: translateY(14px); } to { opacity: 1; transform: translateY(0); } }
      @keyframes draw { to { stroke-dashoffset: 0; } }
      @keyframes spin { to { transform: rotate(360deg); } }

      @media (prefers-reduced-motion: reduce) {
        .hero-inner { animation: none; }
        .mark path { animation: none; stroke-dashoffset: 0; }
        .stamp svg { animation: none; }
      }

      @media (max-width: 860px) {
        .hero-inner { flex-direction: column-reverse; text-align: center; gap: 36px; }
        .headline, .bio { max-width: none; }
        .hero-actions { justify-content: center; }
        .stats-inner { grid-template-columns: repeat(2, 1fr); }
        .stat:nth-child(3) { border-left: none; }
        .stat:nth-child(odd) { border-left: none; }
        .service-grid { grid-template-columns: repeat(2, 1fr); }
      }

      @media (max-width: 480px) {
        .hero { padding: 64px 20px 50px; }
        .cta { padding: 16px 60px 16px 18px; }
        .service-grid { grid-template-columns: 1fr; }
        .stats-inner { grid-template-columns: 1fr 1fr; }
      }
    </style>
  </body>
</html>
